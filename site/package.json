{
  "name": "what-fear-looks-like-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --base /what-fear-looks-like/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,css}\" \"studios/**/*.{js,css}\" \"tests/**/*.js\" \"*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"studios/**/*.{js,css}\" \"tests/**/*.js\" \"*.{js,json}\"",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "1.48.2",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "vite": "^6.3.5",
    "vite-plugin-static-copy": "^2.3.2"
  }
}
